    "cSpell.diagnosticLevel": "Error",
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.buildDirectory": "${workspaceFolder}/build-rpi",
    "cmake.generator": "Ninja",
    "cmake.ninjaPath": "${workspaceFolder}/../../ToolChains/Ninja/ninja.exe",
    "cmake.configureSettings": {
        "CMAKE_TOOLCHAIN_FILE": "${workspaceFolder}/cmake/toolchains/aarch64-linux-gnu.cmake",
        "CMAKE_MAKE_PROGRAM": "${workspaceFolder}/../../ToolChains/Ninja/ninja.exe",
        "TOOLCHAIN_BIN_DIR": "${workspaceFolder}/../../ToolChains/SysGCC/GCC64RasPi4/gccArmCrossCompiler/bin",
        "CMAKE_C_COMPILER": "${workspaceFolder}/../../ToolChains/SysGCC/GCC64RasPi4/gccArmCrossCompiler/bin/aarch64-none-linux-gnu-gcc.exe",
        "CMAKE_CXX_COMPILER": "${workspaceFolder}/../../ToolChains/SysGCC/GCC64RasPi4/gccArmCrossCompiler/bin/aarch64-none-linux-gnu-g++.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
    },
    "raspi.host": "192.168.0.40",
    "raspi.user": "pi",
    "raspi.keyPath": "$env:USERPROFILE\\.ssh\\id_ed25519",
    "raspi.createKeyIfMissing": false,
    "raspi.installPublicKey": false,
    "raspi.sudoPassword": "raspberry",
    "raspi.preDebugCommands": [
        "sudo test -d /home/pi/PSD/GenVariants/64Bit_Raspberry && chmod 777 /home/pi/PSD/GenVariants/64Bit_Raspberry",
        "sudo test -e /dev/ttyAMA0 && chmod 777 /dev/ttyAMA0",
        "sudo test -e /dev/mem && chgrp devmem /dev/mem && chmod 0660 /dev/mem",
        "sudo test -e /dev/gpiomem && chmod 777 /dev/gpiomem",
        "sudo test -e /dev/i2c-1 && chmod 777 /dev/i2c-1",
        "sudo getent group gpio >/dev/null 2>&1 && usermod -a -G gpio pi",
        "sudo getent group spi  >/dev/null 2>&1 && usermod -a -G spi pi"
    ],
    "raspi.programArgs": [10,2],
    "raspi.remoteBinary": "/home/pi/JokiAutomation/RasPiAutomation",
    "custom.toolchainsRoot": "..\\..\\ToolChains"
}