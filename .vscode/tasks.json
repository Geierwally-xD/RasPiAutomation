{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RasPi: Diagnose glibc/WiringPi",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\rpi_diagnose.ps1",
        "-HostName",
        "${config:raspi.host}",
        "-UserName",
        "${config:raspi.user}"
      ],
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "RasPi: Sync sysroot (optional)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\sync_sysroot_from_pi.ps1",
        "-HostName",
        "${config:raspi.host}",
        "-UserName",
        "${config:raspi.user}"
      ],
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "RasPi: Enable /dev/mem (udev)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\enable_devmem_access.ps1",
        "-HostName",
        "${config:raspi.host}",
        "-UserName",
        "${config:raspi.user}",
        "-KeyPath",
        "${config:raspi.keyPath}",
        "-SudoPassword",
        "${config:raspi.sudoPassword}"
      ],
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Start gdbserver (script)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\start_gdbserver.ps1",
        "-HostName",
        "${config:raspi.host}",
        "-User",
        "${config:raspi.user}",
        "-CreateKeyIfMissing",
        "${config:raspi.createKeyIfMissing}",
        "-InstallPublicKey",
        "${config:raspi.installPublicKey}",
        "-Yes"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Build + Start gdbserver",
      "dependsOn": [
        "CMake: Build (RasPi)",
        "Start gdbserver (script)"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure (RasPi)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\cmake_configure_rpi.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-BuildDir",
        "${workspaceFolder}\\build-rpi"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Build (RasPi)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-rpi"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: Clean (RasPi)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-rpi",
        "--target",
        "clean"
      ],
      "group": "none",
      "problemMatcher": []
    }
  ]
}
