{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CodeDiff: Source-Report (C/H)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\generate_source_diff_report.ps1",
        "-ConfigPath",
        "${workspaceFolder}\\scripts\\codediff.raspi.json",
        "-FromTaskEnvironment"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CODEDIFF_NEW": "${input:codeDiffNew}",
          "CODEDIFF_OLD": "${input:codeDiffOld}",
          "CODEDIFF_REFERENCES": "${input:codeDiffReferences}",
          "CODEDIFF_DESCRIPTION": "${input:codeDiffDescription}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "CodeDiff: JoKiAutomation Source-Report (C#)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\generate_source_diff_report.ps1",
        "-ConfigPath",
        "${workspaceFolder}\\scripts\\codediff.csharp.json",
        "-FromTaskEnvironment"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CODEDIFF_NEW": "${input:codeDiffNew}",
          "CODEDIFF_OLD": "${input:codeDiffOld}",
          "CODEDIFF_REFERENCES": "${input:codeDiffReferences}",
          "CODEDIFF_DESCRIPTION": "${input:codeDiffDescription}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    // ── Configure ───────────────────────────────────────────────────────────
    {
      "label": "Configure (RasPi Debug)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\cmake_configure_rpi.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-BuildDir",
        "${workspaceFolder}\\build-rpi-debug",
        "-BuildType",
        "Debug",
        "-ForceFresh"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },

    {
      "label": "Configure (RasPi Release)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\cmake_configure_rpi.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-BuildDir",
        "${workspaceFolder}\\build-rpi-release",
        "-BuildType",
        "Release",
        "-ForceFresh"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },

    // ── Build ───────────────────────────────────────────────────────────────
    {
      "label": "Build Debug (RasPi)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Configure (RasPi Debug)"
      ],
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-rpi-debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },

    {
      "label": "Build Release (RasPi)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Configure (RasPi Release)"
      ],
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-rpi-release"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },

    {
      "label": "Update RasPi (Release)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build Release (RasPi)",
        "Deploy Release Binary (RasPi)"
      ],
      "group": "build",
      "problemMatcher": []
    },

    {
      "label": "Deploy Release Binary (RasPi)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\deploy_raspi_binary.ps1",
        "-HostName",
        "${config:raspi.host}",
        "-UserName",
        "${config:raspi.user}",
        "-KeyPath",
        "${config:raspi.keyPath}",
        "-LocalBinary",
        "${workspaceFolder}\\build-rpi-release\\RasPiAutomation",
        "-RemoteBinary",
        "${config:raspi.remoteBinary}",
        "-Yes"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },

    // ── Clean ───────────────────────────────────────────────────────────────
    {
      "label": "Clean (RasPi)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\cmake_clean_rpi.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}"
      ],
      "group": {
        "kind": "build"
      },
      "problemMatcher": []
    },

    // ── Debug Helper ────────────────────────────────────────────────────────
    {
      "label": "Debug RasPi (Remote)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build Debug (RasPi)",
        "Start GDBServer (Debug Binary)"
      ],
      "group": "build",
      "problemMatcher": []
    },

    {
      "label": "Start GDBServer (Debug Binary)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/start_gdbserver.ps1",
        "-LocalBinary",
        "${workspaceFolder}\\build-rpi-debug\\RasPiAutomation",
        "-Yes"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\[ERROR\\]\\s+(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Preparing remote directory",
          "endsPattern": "^gdbserver started on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },

    // ── Utilities ───────────────────────────────────────────────────────────
    {
      "label": "RasPi: Diagnose glibc/pigpio",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\rpi_diagnose.ps1",
        "-HostName",
        "${config:raspi.host}",
        "-UserName",
        "${config:raspi.user}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },

    {
      "label": "RasPi: Sync sysroot (optional)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\sync_sysroot_from_pi.ps1",
        "-HostName",
        "${config:raspi.host}",
        "-UserName",
        "${config:raspi.user}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },

    {
      "label": "RasPi: Enable /dev/mem (udev)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\enable_devmem_access.ps1",
        "-HostName",
        "${config:raspi.host}",
        "-UserName",
        "${config:raspi.user}",
        "-KeyPath",
        "${config:raspi.keyPath}",
        "-SudoPassword",
        "${config:raspi.sudoPassword}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },

    {
      "label": "Set ToolChain Environment Variable",
      "type": "shell",
      "command": "${workspaceFolder}/SetToolChain.bat",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    }
  ],
  "inputs": [
    {
      "id": "codeDiffNew",
      "type": "promptString",
      "description": "Neuer Git-Stand: Tag oder Commit-ID",
      "default": "JOKI_T1011_PIPES"
    },
    {
      "id": "codeDiffOld",
      "type": "promptString",
      "description": "Alter Git-Stand: Tag oder Commit-ID",
      "default": "JOKI_T1010_PIGPIO"
    },
    {
      "id": "codeDiffReferences",
      "type": "promptString",
      "description": "Optional: Referenzdateien (PDF/TXT/MD/LOG), Pfade mit Semikolon trennen; leer = keine",
      "default": ""
    },
    {
      "id": "codeDiffDescription",
      "type": "promptString",
      "description": "Optional: Warum wurde die Aenderung eingebaut? Kontext fuer die Codekommentare",
      "default": ""
    }
  ]
}
