{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug RasPiAutomation",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build-rpi\\RasPiAutomation",
      "args": ["10", "2"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "HOME", "value": "${env:USERPROFILE}" }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/../../ToolChains/SysGCC/GCC64RasPi4/gccArmCrossCompiler/bin/aarch64-none-linux-gnu-gdb.exe",
      "miDebuggerServerAddress": "${config:raspi.host}:2345",
      "targetArchitecture": "arm64",
      "launchCompleteCommand": "exec-continue",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Disable pagination",
          "text": "set pagination off",
          "ignoreFailures": true
        },
        {
          "description": "Set sysroot for remote debugging",
          "text": "-gdb-set sysroot ${workspaceFolder}/../../ToolChains/SysGCC/GCC64RasPi4/gccArmCrossCompiler/aarch64-none-linux-gnu/libc",
          "ignoreFailures": true
        },
        {
          "description": "Shared library search path (Pi sysroot)",
          "text": "-gdb-set solib-search-path ${workspaceFolder}/../../ToolChains/SysGCC/GCC64RasPi4/gccArmCrossCompiler/aarch64-none-linux-gnu/libc/lib/aarch64-linux-gnu:${workspaceFolder}/../../ToolChains/SysGCC/GCC64RasPi4/gccArmCrossCompiler/sysroot-pi/usr/local/lib",
          "ignoreFailures": true
        },
        {
          "description": "Suppress SIG34 (aarch64 threading signal)",
          "text": "handle SIG34 nostop noprint pass",
          "ignoreFailures": true
        },
        {
          "description": "Skip pigpio while stepping",
          "text": "skip -gfi /usr/lib*/libpigpio.so*",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "4 ▸ Build Debug + Start GDBServer",
      "logging": {
        "engineLogging": true,
        "trace": true,
        "traceResponse": true
      }
    },
    {
      "name": "Attach to GDBServer (no build)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build-rpi\\RasPiAutomation",
      "args": ["10", "2"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "HOME", "value": "${env:USERPROFILE}" }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/../../ToolChains/SysGCC/GCC64RasPi4/gccArmCrossCompiler/bin/aarch64-none-linux-gnu-gdb.exe",
      "miDebuggerServerAddress": "${config:raspi.host}:2345",
      "targetArchitecture": "arm64",
      "launchCompleteCommand": "exec-continue",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Disable pagination",
          "text": "set pagination off",
          "ignoreFailures": true
        },
        {
          "description": "Set sysroot for remote debugging",
          "text": "-gdb-set sysroot ${workspaceFolder}/../../ToolChains/SysGCC/GCC64RasPi4/gccArmCrossCompiler/aarch64-none-linux-gnu/libc",
          "ignoreFailures": true
        },
        {
          "description": "Shared library search path (Pi sysroot)",
          "text": "-gdb-set solib-search-path ${workspaceFolder}/../../ToolChains/SysGCC/GCC64RasPi4/gccArmCrossCompiler/aarch64-none-linux-gnu/libc/lib/aarch64-linux-gnu:${workspaceFolder}/../../ToolChains/SysGCC/GCC64RasPi4/gccArmCrossCompiler/sysroot-pi/usr/local/lib",
          "ignoreFailures": true
        },
        {
          "description": "Suppress SIG34 (aarch64 threading signal)",
          "text": "handle SIG34 nostop noprint pass",
          "ignoreFailures": true
        },
        {
          "description": "Skip pigpio while stepping",
          "text": "skip -gfi /usr/lib*/libpigpio.so*",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
